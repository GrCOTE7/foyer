# Build de la documentation (source assemblée et rendu HTML), non versionné.
/.build/*
!/.build/.gitkeep
!/.build/docs/
/.build/docs/*
!/.build/docs/.gitkeep
/site/

# Environnement virtuel de prévisualisation locale du site
/.venv-docs/
__pycache__/

# Archives de contribution déposées à la racine ("drops"). Leur contenu est
# réconcilié dans l'arbre puis l'archive est jetée — elle ne doit jamais être
# committée telle quelle, ni servir de source de vérité.
*.zip

bmad/livrables/test
